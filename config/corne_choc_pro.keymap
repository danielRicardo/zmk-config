#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        TLT: TLT {
            compatible = "zmk,behavior-hold-tap";
            label = "TLT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };

        HRM_R: HRM_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 14 15 16 17 18 19 28 29 30 31 32 33 40 41 42>;
        };

        HRM_L: HRM_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <8 9 10 11 12 13 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAIN {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q                   &kp W                          &kp E              &kp R             &kp T              &none  &none  &kp Y               &kp U            &kp I               &kp O                           &kp P                      &kp BSPC
&kp LCTRL  &HRM_L LS(LA(LCTRL)) A  &HRM_L LS(LA(LC(LEFT_GUI))) S  &HRM_L LEFT_GUI D  &HRM_L LCTRL F    &HRM_L LEFT_ALT G  &none  &none  &HRM_R RIGHT_ALT H  &HRM_R RCTRL J   &HRM_R RIGHT_GUI K  &HRM_R RS(RA(RC(RIGHT_GUI))) L  &HRM_R RS(RA(RCTRL)) SEMI  &kp SQT
&kp LSHFT  &kp Z                   &kp X                          &kp C              &kp V             &kp B                            &kp N               &kp M            &kp COMMA           &kp DOT                         &kp FSLH                   &kp ESC
                                                                  &TLT 3 TAB         &TLT 2 BACKSPACE  &TLT 1 SPACE                     &TLT 4 RETURN       &kp RIGHT_SHIFT  &TLT 3 APOS
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&trans  &trans             &trans                    &trans    &trans     &trans    &trans  &trans  &kp FSLH   &kp N7   &kp N8  &kp N9  &kp MINUS  &trans
&trans  &kp LS(LA(LCTRL))  &kp LS(LA(LC(LEFT_GUI)))  &kp LGUI  &kp LCTRL  &kp LALT  &trans  &trans  &kp STAR   &kp N4   &kp N5  &kp N6  &kp PLUS   &trans
&trans  &trans             &trans                    &trans    &trans     &trans                    &kp MINUS  &kp N1   &kp N2  &kp N3  &kp DOT    &trans
                                                     &trans    &trans     &trans                    &kp RSHFT  &kp RET  &kp N0
            >;
        };

        NAV {
            display-name = "NAV";
            bindings = <
&bt BT_CLR      &bt BT_SEL 4       &bt BT_SEL 3          &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans  &trans  &kp HOME      &kp PG_DN  &kp PG_UP  &kp END        &kp C_VOLUME_UP    &rgb_ug RGB_TOG
&studio_unlock  &kp LS(LA(LCTRL))  &kp LS(LA(LC(LGUI)))  &kp LGUI      &kp LCTRL     &kp LALT      &trans  &trans  &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &kp C_VOLUME_DOWN  &rgb_ug RGB_EFF
&trans          &kp K_UNDO         &kp K_CUT             &kp K_COPY    &kp K_PASTE   &kp K_FIND                    &kp LA(LEFT)  &trans     &trans     &kp LA(RIGHT)  &kp K_MUTE         &rgb_ug RGB_COLOR_HSB(227,82,38)
                                                         &trans        &trans        &trans                        &kp RSHFT     &kp RET    &kp DEL
            >;
        };

        SYMBOL {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp GRAVE  &trans    &trans     &trans     &trans  &trans  &trans  &kp LBKT  &kp AMPS    &kp STAR   &kp TILDE  &kp RBKT  &trans
&trans  &kp EQUAL  &kp PLUS  &kp UNDER  &kp MINUS  &trans  &trans  &trans  &kp LBRC  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp RBRC  &trans
&trans  &trans     &trans    &trans     &trans     &trans                  &kp PIPE  &kp EXCL    &kp AT     &kp HASH   &kp BSLH  &trans
                             &trans     &trans     &trans                  &kp LPAR  &kp RPAR    &kp DQT
            >;
        };

        FUNC {
            display-name = "FUNC";
            bindings = <
&tog 0  &kp F10  &kp F9  &kp F8  &kp F7   &caps_word      &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4   &kp CAPS        &trans  &trans  &kp LA(SPACE)  &kp LC(SPACE)  &kp LG(SPACE)  &trans  &trans  &trans
&trans  &kp F12  &kp F3  &kp F2  &kp F1   &kp KP_NUMLOCK                  &trans         &trans         &trans         &trans  &trans  &trans
                         &trans  &kp ESC  &trans                          &trans         &trans         &trans
            >;
        };
    };
};
